# MochilaLista — Normalización determinista de finales de línea y binarios
* text=auto

# Scripts Windows obligatorios con CRLF para cmd.exe y PowerShell 5.1
*.bat text eol=crlf
*.ps1 text eol=crlf

# Código fuente, web y documentación consistentes con LF
*.dart text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.properties text eol=lf

# Activos binarios y criptográficos (nunca alterar bytes)
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.ttf binary
*.otf binary
*.ogg binary
*.apk binary
*.jks binary
*.keystore binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.mlvault binary
*.mlkey binary
*.xlsx binary
*.pdf binary
*.zip binary
